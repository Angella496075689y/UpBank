  <style>

    * {

      box-sizing: border-box;

    }

    body {

      font-family: Arial, sans-serif;

      background: white(255, 255, 255)
      text-align: center;

      padding: 35px 15px;

      margin: 0;

    }

    .card {

      background: white;

      max-width: 360px;

      margin: 35px auto;

