    .balance-label {

      color: #60738b;

      font-size: 14px;

      margin: 0 0 10px;

    }

    .balance-amount {

      color: #173f6b;

      font-size: 32px;

      margin: 0 0 18px;

      overflow-wrap: anywhere;

    }

    .account-label {

      color: #60738b;

      font-size: 13px;

      margin-top: 14px;

    }

    .transaction-card h2 {

      color: #173f6b;

      margin-top: 0;

    }

    .transaction-row {

      display: flex;

      justify-content: space-between;

      align-items: center;

      gap: 15px;

      padding: 17px 12px;

      margin: 0-12px;

      border-bottom: 1px solid #e5ebf2;

      border-radius: 8px;

      font-size: 14px;

      transition: background 0.2s ease;
    }
    .transaction-row:hover {
      background: #f3f7fc;

    }

    .transaction-name {

      font-weight: bold;

      color: #243b53;

    }

    .transaction-date {

      display: block;

      color: #73849a;

      font-size: 12px;

      margin-top: 5px;

    }

    .transaction-amount {

      font-weight: bold;

      white-space: nowrap;

    }

    .credit {

      color: #16804a;

    }

    .debit {

      color: #34465a;

    }

    @media (max-width: 480px) {

      body {

        padding: 22px 12px;

      }

