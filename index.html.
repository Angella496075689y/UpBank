const actionDefinitions = {
  Transfer: {
    title: 'Transfer Money',
    description: 'Enter the recipient and transfer details.',
    fields: [
      { name: 'recipient', label: 'Recipient name', type: 'text', required: true },
      { name: 'account', label: 'Recipient account', type: 'text', required: true },
      { name: 'amount', label: 'Amount', type: 'number', required: true }
    ]
  },

  Withdraw: {
    title: 'Withdraw Funds',
    description: 'Enter your withdrawal request details.',
    fields: [
      { name: 'method', label: 'Withdrawal method', type: 'text', required: true },
      { name: 'amount', label: 'Amount', type: 'number', required: true }
    ]
  },

  Savings: {
    title: 'Savings Goals',
    description: 'Set a target for your savings.',
    fields: [
      { name: 'goal', label: 'Savings goal', type: 'text', required: true },
      { name: 'target', label: 'Target amount', type: 'number', required: true },
      { name: 'date', label: 'Target date', type: 'date', required: true }
    ]
  },

  Investment: {
    title: 'Investment',
    description: 'Review investment options.',
    fields: [
      { name: 'plan', label: 'Investment plan', type: 'text', required: true },
      { name: 'amount', label: 'Amount to invest', type: 'number', required: true }
    ]
  },

  Betting: {
    title: 'Betting',
    description: 'Betting provider integration is required for real bets.',
    fields: [
      { name: 'provider', label: 'Provider', type: 'text', required: true }
    ]
  },

  Statement: {
    title: 'Account Statement',
    description: 'Choose a date range for your statement.',
    fields: [
      { name: 'startDate', label: 'Start date', type: 'date', required: true },
      { name: 'endDate', label: 'End date', type: 'date', required: true }
    ]
  },

  'Pay Bills': {
    title: 'Pay Bills',
    description: 'Enter your bill details.',
    fields: [
      { name: 'billType', label: 'Bill type', type: 'text', required: true },
      { name: 'reference', label: 'Bill reference', type: 'text', required: true },
      { name: 'amount', label: 'Amount', type: 'number', required: true }
    ]
  }
};

function showActionMessage(message) {
  const result = document.getElementById('actionResult');
  if (result) result.textContent = message;
}

function showActionScreen(action) {
  const config = actionDefinitions[action];

  if (!config) {
    showActionMessage('This feature is not configured yet.');
    return;
  }

  const screen = document.getElementById('actionScreen');
  const title = document.getElementById('actionTitle');
  const description = document.getElementById('actionDescription');
  const formArea = document.getElementById('actionFormArea');

  if (!screen || !title || !description || !formArea) {
    console.error('Action screen HTML elements are missing.');
    return;
  }

  title.textContent = config.title;
  description.textContent = config.description;
  formArea.replaceChildren();

  const form = document.createElement('form');

  config.fields.forEach(function (field) {
    const label = document.createElement('label');
    label.htmlFor = 'action-' + field.name;
    label.textContent = field.label;

    const input = document.createElement('input');
input.id = label.htmlFor;
input.name = field.name;
input.type = field.type;
input.required = field.required;

input.placeholder = field.type === 'number'
  ? 'Enter amount'
  : field.type === 'date'
    ? 'Select date'
    : 'Enter ' + field.label.toLowerCase();

input.autocomplete = 'off';

    if (field.type === 'number') {
      input.min = '0.01';
      input.step = '0.01';
    }

    form.append(label, input);
  });

  const submit = document.createElement('button');
  submit.type = 'submit';
  submit.textContent = 'Submit Request';
  form.appendChild(submit);

  form.addEventListener('submit', function (event) {
    event.preventDefault();

    if (!form.reportValidity()) return;

    const values = Object.fromEntries(
      new FormData(form).entries()
    );

    console.log('Validated request:', {
      action: action,
      fields: values
    });

    showActionMessage(
      'Form completed. This feature is not connected to a financial provider. No money has moved.'
    );
  });

  formArea.appendChild(form);

  const quickActions = document.querySelector('.quick-actions-card');
  const transactions = document.querySelector('.transaction-card');

  if (quickActions) quickActions.style.display = 'none';
  if (transactions) transactions.style.display = 'none';

  screen.style.display = 'block';
  screen.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function closeActionScreen() {
  const screen = document.getElementById('actionScreen');
  const quickActions = document.querySelector('.quick-actions-card');
  const transactions = document.querySelector('.transaction-card');

  if (screen) screen.style.display = 'none';
  if (quickActions) quickActions.style.display = 'block';
  if (transactions) transactions.style.display = 'block';

  const formArea = document.getElementById('actionFormArea');
  if (formArea) formArea.replaceChildren();

  showActionMessage('');
}

// Keeps your existing action buttons working.
function showAction(action) {
  showActionScreen(action);
}

    // Hide or show the sample balance.

    toggleBalanceBtn.addEventListener('click', function () {

      balanceHidden = !balanceHidden;

      balanceAmount.textContent = balanceHidden

        ? '••••••••'

        : originalBalance;

      toggleBalanceBtn.textContent = balanceHidden

        ? 'SHOW BALANCE'

        : 'HIDE BALANCE';

    });

    // Sign in with Supabase Authentication.

    signInBtn.addEventListener('click', async function () {

      if (!supabaseClient) {

        loginMessage.textContent =

          'Sign-in is unavailable. Check the Supabase setup.';

        loginMessage.style.color = 'red';

        return;

      }

      const email = document.getElementById('email').value.trim();

      const password = document.getElementById('password').value;

      if (!email || !password) {

        loginMessage.textContent =

          'Please enter your email and password.';

        loginMessage.style.color = 'red';

        return;

      }

      signInBtn.disabled = true;

      signInBtn.textContent = 'SIGNING IN...';

      loginMessage.textContent = '';

      try {

        const { data, error } =

          await supabaseClient.auth.signInWithPassword({

            email: email,

            password: password

          });

        if (error) {

          loginMessage.textContent =

            'Sign-in failed. Check your credentials and email confirmation.';

          loginMessage.style.color = 'red';

          return;

        }

        if (data.user) {

          signInCard.style.display = 'none';

          dashboard.style.display = 'block';

        }

      } catch (error) {

        console.error('Sign-in error:', error);

        loginMessage.textContent =

          'Unable to connect. Please check your internet connection.';

        loginMessage.style.color = 'red';

      } finally {

        signInBtn.disabled = false;

        signInBtn.textContent = 'SIGN IN';

      }

    });

    // Log out.

    logoutBtn.addEventListener('click', async function () {

      if (!supabaseClient) {

        return;

      }

      logoutBtn.disabled = true;

      try {

        const { error } = await supabaseClient.auth.signOut();

        if (error) {

          alert('Unable to log out. Please try again.');

          return;

        }

        dashboard.style.display = 'none';

        signInCard.style.display = 'block';

        loginMessage.textContent = 'You have logged out successfully.';

        loginMessage.style.color = 'green';

        document.getElementById('password').value = '';

      } catch (error) {

        console.error('Logout error:', error);

        alert('Unable to log out. Please try again.');

      } finally {

        logoutBtn.disabled = false;

      }

    });

  </script>

