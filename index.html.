    h1 {

      color: #174b79;

      font-size: 30px;

    }

    button {

      background: #174b7d;

      color: white;

      padding: 13px 22px;

      border: none;

      border-radius: 8px;

      cursor: pointer;

      font-size: 15px;

      font-weight: bold;

    }

    button:disabled {

      opacity: 0.65;

      cursor: not-allowed;

    }

    label,

